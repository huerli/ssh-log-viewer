{
  "name": "ssh-log-viewer",
  "version": "0.0.16",
  "packageManager": "pnpm@11.25.0",
  "description": "SSH remote log viewer with disk-backed indexing",
  "private": true,
  "main": "electron/main.cjs",
  "desktopName": "com.teee.sshlogviewer.desktop",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:desktop": "node test/desktop.cjs",
    "test:batch": "node test/batch-transfer.cjs",
    "test:jump": "node test/jump-desktop.cjs",
    "test:jump-auth": "node test/jump-auth.cjs",
    "pack": "tsc --noEmit && vite build && electron-builder --dir",
    "test:font": "node test/font-settings.cjs",
    "test:copy-result": "node test/copy-search-result.cjs",
    "test:export": "node test/search-export.cjs",
    "test:priority": "node test/search-priority.cjs",
    "test:stream": "node test/stream-search.cjs",
    "test:history": "node test/search-history.cjs",
    "test:folder": "node test/local-folder.cjs",
    "test:host-conflict": "node test/host-conflict.cjs",
    "test:download-origin": "node test/download-origin.cjs",
    "test:terminal": "node test/terminal-desktop.cjs",
    "test:jump-release": "node test/jump-release-desktop.cjs",
    "test:update": "node test/update-desktop.cjs",
    "test:commands": "node test/command-bar.cjs",
    "test:connection-transfer": "node test/connection-transfer.cjs",
    "test:open-position": "node test/open-position.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io-client": "^4.8.4",
    "ssh2": "^1.17.0",
    "tar-stream": "^3.1.7",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "com.teee.sshlogviewer",
    "productName": "SSH Log Viewer",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**",
      "electron/**",
      "shared/**",
      "assets/**",
      "package.json"
    ],
    "icon": "assets/icon",
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Development",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "author": {
    "name": "huerli",
    "email": "2556892336@qq.com"
  }
}
